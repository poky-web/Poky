import pygame
import random
import sys

# Инициализация Pygame
pygame.init()

# Размеры окна (Экран)
WIDTH = 800
HEIGHT = 600
screen = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Игра Футболист")

# Цвета
WHITE = (255, 255, 255)

# =========================================================
# ЗАДАНИЕ 3.3: ИЗМЕНЕНИЕ НАСТРОЕК ИГРЫ (Ищите эти переменные)
# =========================================================

# 1. СКОРОСТЬ МЯЧА (измените эти числа, чтобы мяч летал быстрее)
ball_speed_x = 5  
ball_speed_y = 5  

# 2. КОЛИЧЕСТВО ЖИЗНЕЙ (поменяйте, например, на 5 или 10)
lives = 3  

# Очки игрока
score = 0

# Загрузка изображений
# ЗАДАНИЕ 3.3: ИЗМЕНЕНИЕ РАЗМЕРА ФОНА ПОД РАЗМЕР ОКНА
background = pygame.image.load('pole.png')
background = pygame.transform.scale(background, (WIDTH, HEIGHT)) # Масштабирование фона

# ЗАДАНИЕ 3.3: ИЗМЕНЕНИЕ РАЗМЕРА ФУТБОЛИСТА
# (Поменяйте числа 100, 150 на другие, чтобы уменьшить/увеличить игрока)
player_img = pygame.image.load('footballer1.png')
player_img = pygame.transform.scale(player_img, (100, 150)) 

ball_img = pygame.image.load('football.png')
ball_img = pygame.transform.scale(ball_img, (40, 40))

# Координаты объектов
player_x = WIDTH // 2 - 50
player_y = HEIGHT - 160
player_speed = 8

ball_x = random.randint(50, WIDTH - 50)
ball_y = 50

# Шрифты для текста
font = pygame.font.SysFont('Arial', 36)

clock = pygame.time.Clock()
game_over = False

# Главный игровой цикл
while True:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            pygame.quit()
            sys.exit()

    if not game_over:
        # Управление игроком (стрелки влево/вправо)
        keys = pygame.key.get_pressed()
        if keys[pygame.K_LEFT] and player_x > 0:
            player_x -= player_speed
        if keys[pygame.K_RIGHT] and player_x < WIDTH - 100:
            player_x += player_speed

        # Движение мяча
        ball_x += ball_speed_x
        ball_y += ball_speed_y

        # Отскок мяча от стен
        if ball_x <= 0 or ball_x >= WIDTH - 40:
            ball_speed_x *= -1
        if ball_y <= 0:
            ball_speed_y *= -1

        # Проверка: отбит ли мяч футболистом (Коллизия)
        player_rect = pygame.Rect(player_x, player_y, 100, 150)
        ball_rect = pygame.Rect(ball_x, ball_y, 40, 40)

        if player_rect.colliderect(ball_rect):
            ball_speed_y *= -1
            ball_y = player_y - 40
            score += 1 # Увеличение очков

        # Если мяч улетел вниз (пропущен гол)
        if ball_y > HEIGHT:
            lives -= 1 # Уменьшение жизней
            # Возвращаем мяч наверх
            ball_x = random.randint(50, WIDTH - 50)
            ball_y = 50
            ball_speed_y = abs(ball_speed_y) # летит вниз

            if lives <= 0:
                game_over = True

    # Отрисовка графики
    screen.blit(background, (0, 0)) # Рисуем фон
    screen.blit(player_img, (player_x, player_y)) # Рисуем игрока
    screen.blit(ball_img, (ball_x, ball_y)) # Рисуем мяч

    # Вывод очков и жизней на экран
    score_text = font.render(f"Очки: {score}", True, WHITE)
    lives_text = font.render(f"Жизни: {lives}", True, WHITE)
    screen.blit(score_text, (20, 20))
    screen.blit(lives_text, (WIDTH - 150, 20))

    # Если игра окончена
    if game_over:
        game_over_text = font.render("КОНЕЦ ИГРЫ", True, (255, 0, 0))
        screen.blit(game_over_text, (WIDTH // 2 - 100, HEIGHT // 2))

    pygame.display.flip()
    clock.tick(60)

